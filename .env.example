# Bu faylı köçürüb ".env" adlandır, sonra öz açarlarını yaz.
# .env faylı ASLA GitHub-a push edilməməlidir (.gitignore-da var).

PORT=3000

# platform.openai.com -> API keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# console.groq.com -> API keys (Repetitor-da istifadə etdiyin açarlardan biri)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Azərbaycan dilini dəstəkləyən səs ID-si (ElevenLabs Voice Library-dən seç)
ELEVENLABS_VOICE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Serverin özünün canlı (Railway) domeni - deploy etdikdən sonra doldurulacaq
# məsələn: sg-voice-agent-production.up.railway.app
PUBLIC_HOSTNAME=

# AI-nın danışıq tərzini müəyyən edən sistem təlimatı
AGENT_SYSTEM_PROMPT="Sən SECURITY GROUP-un telefon köməkçisisən. Azərbaycan dilində, qısa və səmimi cavab ver."
AGENT_GREETING="Salam, necə kömək edə bilərəm?"
